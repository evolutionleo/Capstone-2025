--- !u!114 &183677848
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 183677847}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ffc16e8cd90a412f96cdef90dcd3db51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  BulbPlace: {fileID: 1452526823}
  dialogs:
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0422\u0440\u0438\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0410? \u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0422\u0430\u043A \u0438 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
      \u043D\u0438\u0447\u0435\u0433\u043E \u0443 \u043D\u0438\u0445 \u043D\u0435
      \u0432\u044B\u0439\u0434\u0435\u0442, \u0437\u0430\u043F\u0438\u0442\u0430\u0442\u044C
      \u0440\u0430\u0437\u043E\u043C \u0446\u0435\u043B\u044B\u0439 \u0433\u043E\u0440\u043E\u0434\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0423\u0445! \u041E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0437\u0434\u0435\u0441\u044C
      \u0432\u0437\u044F\u043B\u0441\u044F?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0414\u043E\u043B\u0436\u0435\u043D \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0432\u0441\u0435
      \u0436\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u043B\u0438."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438-\u043A\u0430\u2026 \u0422\u044B
      \u043A\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435? \u0417\u0434\u0435\u0441\u044C
      \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C!"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0418\u043B\u0438 \u0442\u044B \u0438 \u0435\u0441\u0442\u044C \u0442\u043E\u0442,
      \u043A\u0442\u043E \u0441\u043F\u0430\u0441\u0435\u0442 \u043D\u0430\u0441?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E, \u044F
      \u043D\u0435 \u0437\u043D\u0430\u044E \u0434\u0430\u0436\u0435 \u043A\u0430\u043A
      \u0441\u043F\u0430\u0441\u0442\u0438 \u0441\u0435\u0431\u044F. \u041C\u043E\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043F\u043E\u0442\u0435\u0440\u043F\u0435\u043B
      \u043A\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0437\u0434\u0435\u0441\u044C."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0422\u043E\u0433\u0434\u0430 \u0438 \u0432\u044B \u0441\u043A\u043E\u0440\u043E
      \u0440\u0430\u0437\u0440\u044F\u0434\u0438\u0442\u0435\u0441\u044C. \u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435,
      \u043D\u043E \u0437\u0434\u0435\u0441\u044C \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u0438\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u041D\u043E \u043C\u043E\u0439 \u0440\u0430\u0434\u0430\u0440 \u0437\u0430\u0441\u0435\u043A
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0433\u0434\u0435-\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C.. \u0430 \u0435\u0449\u0435 \u044D\u0442\u043E\u0442
      \u0441\u043A\u043B\u0430\u0434 \u043B\u0430\u043C\u043E\u0447\u0435\u043A \u0438
      \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u043E\u0432?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u043E \u0447\u0435\u043C
      \u0432\u044B\u2026 \u0411\u043E\u044E\u0441\u044C, \u0432\u0430\u0448 \u0440\u0430\u0434\u0430\u0440
      \u0431\u0430\u0440\u0430\u0445\u043B\u0438\u0442."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0412\u0441\u0435, \u0447\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E
      \u0441 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0420\u0430\u0437\u0432\u0435 \u0447\u0442\u043E \u041C\u043E\u0440\u0440\u0438\u0441
      \u0441 \u0435\u0433\u043E \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043C\u0438\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u041E\u043D \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043B
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0438\u0434\u0435\u0438 \u0441 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0435\u0439
      \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C,
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044F \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0443\u0433\u0430\u0441\u0430\u044E\u0449\u0438\u0435 \u0441\u0438\u043B\u044B
      \u0432 \u0435\u0433\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u041E\u043D \u0437\u0430\u0431\u0440\u0430\u043B \u0441\u0432\u043E\u0435
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435, \u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0422\u0430\u043A \u043E\u043D\u0438 \u043C\u043E\u0433\u043B\u0438 \u043D\u0430\u0439\u0442\u0438
      \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u044B\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A, \u043D\u043E \u0432\u0441\u0435
      \u0440\u0430\u0432\u043D\u043E \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u043B\u0438
      \u0431\u0440\u043E\u0441\u0442\u0442\u044C\u0441\u044F \u0432 \u043A\u043E\u0441\u043C\u043E\u0441\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0410 \u043C\u044B \u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
      \u0441\u0430\u043C\u0443\u044E \u043E\u043F\u0430\u0441\u043D\u0443\u044E \u0438\u0437
      \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043E\u043A."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0410 \u044D\u0442\u043E \u041C\u043E\u0440\u0440\u0438\u0441 \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043B
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0412\u0437\u0440\u044B\u0432? \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0447\u0430\u0441\u0442\u044C \u0411\u0430\u0448\u043D\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u043E\u0442 \u0432\u0437\u043B\u0435\u0442\u0430\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0427\u0442\u043E-\u0442\u043E \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u0443 \u043D\u0430\u0441
      \u043D\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0439 \u043D\u0430\u0434\u0435\u0436\u0434\u044B.
      \u0412\u044B \u0441\u043A\u043E\u0440\u043E \u043F\u043E\u0439\u043C\u0435\u0442\u0435,\u0447\u0442\u043E
      \u0432\u044B\u0445\u043E\u0434\u0430 \u043D\u0435\u0442\u0442\u0442\u0442\u0442\u0442."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 1452526822}
    additionalStartPause: 0
    text: "\u0411\u0443\u0434\u0435\u043C \u043D\u0430\u0434-\u0434\u0435\u044F\u0442\u044C\u0441-\u0441\u044F
      \u0432\u043C\u043C\u043C\u0435\u0441\u0442\u0435-\u0442\u0435-\u0442\u0435\u2026"
    additionalEndPause: 2
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u041E\u043D \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B\u0441\u044F."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0414\u0443\u043C\u0430\u044E, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u0440\u044F\u0434 \u043B\u0438 \u0437\u043D\u0430\u044E\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0435\u0449\u0435."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u041B\u0438\u0444\u0442 \u0441\u043B\u043E\u043C\u0430\u043D, \u0445\u043E\u0442\u044F
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B
      \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0410 \u043F\u0440\u043E\u0445\u043E\u0434 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434
      \u043C\u0435\u043B\u043A\u0438\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E
      \u0443\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E \u0432\u0437\u043E\u0440\u0432\u0430\u043D."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E \u0432\u0441\u0435 \u044D\u0442\u043E."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u0427\u0435\u0440\u0442 \u0441 \u0438\u0445 \u0432\u0435\u043B\u0438\u043A\u0438\u043C
      \u0421\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u043C, \u044F \u043D\u0435
      \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C\u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0443\u0441\u044C
      \u0432 \u0433\u0440\u0443\u0434\u0443 \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043B\u043E\u043C\u0430."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 833416435}
    additionalStartPause: 0
    text: "\u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439."
    additionalEndPause: 0
  onDialogEnded:
    m_PersistentCalls:
      m_Calls: []

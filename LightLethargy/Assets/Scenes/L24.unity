      objectReference: {fileID: 0}
    - target: {fileID: 5509492164308268754, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: onTryInstallingBulb.m_PersistentCalls.m_Calls.Array.data[0].m_Arguments.m_ObjectArgumentAssemblyTypeName
      value: UnityEngine.Object, UnityEngine
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.size
      value: 30
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[0].text
      value: "\u0422\u0440\u0438\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[1].text
      value: "\u0410? \u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[2].text
      value: "\u0422\u0430\u043A \u0438 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
        \u043D\u0438\u0447\u0435\u0433\u043E \u0443 \u043D\u0438\u0445 \u043D\u0435
        \u0432\u044B\u0439\u0434\u0435\u0442, \u0437\u0430\u043F\u0438\u0442\u0430\u0442\u044C
        \u0440\u0430\u0437\u043E\u043C \u0446\u0435\u043B\u044B\u0439 \u0433\u043E\u0440\u043E\u0434\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[3].text
      value: "\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[4].text
      value: "\u0423\u0445! \u041E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0437\u0434\u0435\u0441\u044C
        \u0432\u0437\u044F\u043B\u0441\u044F?"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[5].text
      value: "\u0414\u043E\u043B\u0436\u0435\u043D \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
        \u0447\u0442\u043E \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0432\u0441\u0435
        \u0436\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u043B\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[6].text
      value: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438-\u043A\u0430\u2026 \u0422\u044B
        \u043A\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435? \u0417\u0434\u0435\u0441\u044C
        \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
        \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[7].text
      value: "\u0418\u043B\u0438 \u0442\u044B \u0438 \u0435\u0441\u0442\u044C \u0442\u043E\u0442,
        \u043A\u0442\u043E \u0441\u043F\u0430\u0441\u0435\u0442 \u043D\u0430\u0441?"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[8].text
      value: "\u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E, \u044F
        \u043D\u0435 \u0437\u043D\u0430\u044E \u0434\u0430\u0436\u0435 \u043A\u0430\u043A
        \u0441\u043F\u0430\u0441\u0442\u0438 \u0441\u0435\u0431\u044F. \u041C\u043E\u0439
        \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043F\u043E\u0442\u0435\u0440\u043F\u0435\u043B
        \u043A\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0437\u0434\u0435\u0441\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[9].text
      value: "\u0422\u043E\u0433\u0434\u0430 \u0438 \u0432\u044B \u0441\u043A\u043E\u0440\u043E
        \u0440\u0430\u0437\u0440\u044F\u0434\u0438\u0442\u0435\u0441\u044C. \u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435,
        \u043D\u043E \u0437\u0434\u0435\u0441\u044C \u0431\u043E\u043B\u044C\u0448\u0435
        \u043D\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u0438\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[10].text
      value: "\u041D\u043E \u043C\u043E\u0439 \u0440\u0430\u0434\u0430\u0440 \u0437\u0430\u0441\u0435\u043A
        \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0433\u0434\u0435-\u0442\u043E
        \u0437\u0434\u0435\u0441\u044C.. \u0430 \u0435\u0449\u0435 \u044D\u0442\u043E\u0442
        \u0441\u043A\u043B\u0430\u0434 \u043B\u0430\u043C\u043E\u0447\u0435\u043A
        \u0438 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u043E\u0432?"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[11].text
      value: "\u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u043E \u0447\u0435\u043C
        \u0432\u044B\u2026 \u0411\u043E\u044E\u0441\u044C, \u0432\u0430\u0448 \u0440\u0430\u0434\u0430\u0440
        \u0431\u0430\u0440\u0430\u0445\u043B\u0438\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[12].text
      value: "\u0412\u0441\u0435, \u0447\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E
        \u0441 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[13].text
      value: "\u0420\u0430\u0437\u0432\u0435 \u0447\u0442\u043E \u041C\u043E\u0440\u0440\u0438\u0441
        \u0441 \u0435\u0433\u043E \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043C\u0438\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[14].text
      value: "\u041E\u043D \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043B
        \u043F\u0440\u043E\u0442\u0438\u0432 \u0438\u0434\u0435\u0438 \u0441 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0435\u0439
        \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C,
        \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044F \u0431\u0440\u043E\u0441\u0438\u0442\u044C
        \u0443\u0433\u0430\u0441\u0430\u044E\u0449\u0438\u0435 \u0441\u0438\u043B\u044B
        \u0432 \u0435\u0433\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435
        \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[15].text
      value: "\u041E\u043D \u0437\u0430\u0431\u0440\u0430\u043B \u0441\u0432\u043E\u0435
        \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
        \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0433\u043E \u043D\u0435
        \u0432\u0438\u0434\u0435\u043B\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[16].text
      value: "\u0422\u0430\u043A \u043E\u043D\u0438 \u043C\u043E\u0433\u043B\u0438
        \u043D\u0430\u0439\u0442\u0438 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u044B\u0439
        \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A, \u043D\u043E \u0432\u0441\u0435
        \u0440\u0430\u0432\u043D\u043E \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u043B\u0438
        \u0431\u0440\u043E\u0441\u0442\u0442\u044C\u0441\u044F \u0432 \u043A\u043E\u0441\u043C\u043E\u0441\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[17].text
      value: "\u0410 \u043C\u044B \u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
        \u0441\u0430\u043C\u0443\u044E \u043E\u043F\u0430\u0441\u043D\u0443\u044E
        \u0438\u0437 \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
        \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043E\u043A."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[18].text
      value: "\u0410 \u044D\u0442\u043E \u041C\u043E\u0440\u0440\u0438\u0441 \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043B
        \u043F\u0440\u043E\u0445\u043E\u0434 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E?"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[19].text
      value: "\u0412\u0437\u0440\u044B\u0432? \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
        \u0447\u0430\u0441\u0442\u044C \u0411\u0430\u0448\u043D\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
        \u043E\u0442 \u0432\u0437\u043B\u0435\u0442\u0430\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[20].text
      value: "\u0427\u0442\u043E-\u0442\u043E \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[21].text
      value: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u0443
        \u043D\u0430\u0441 \u043D\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0439
        \u043D\u0430\u0434\u0435\u0436\u0434\u044B. \u0412\u044B \u0441\u043A\u043E\u0440\u043E
        \u043F\u043E\u0439\u043C\u0435\u0442\u0435,\u0447\u0442\u043E \u0432\u044B\u0445\u043E\u0434\u0430
        \u043D\u0435\u0442\u0442\u0442\u0442\u0442\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[22].text
      value: "\u0411\u0443\u0434\u0435\u043C \u043D\u0430\u0434-\u0434\u0435\u044F\u0442\u044C\u0441-\u0441\u044F
        \u0432\u043C\u043C\u043C\u0435\u0441\u0442\u0435-\u0442\u0435-\u0442\u0435\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[23].text
      value: "\u041E\u043D \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[24].text
      value: "\u0414\u0443\u043C\u0430\u044E, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
        \u0432\u0440\u044F\u0434 \u043B\u0438 \u0437\u043D\u0430\u044E\u0442 \u0447\u0442\u043E-\u0442\u043E
        \u0435\u0449\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[25].text
      value: "\u041B\u0438\u0444\u0442 \u0441\u043B\u043E\u043C\u0430\u043D, \u0445\u043E\u0442\u044F
        \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B
        \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,"
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[26].text
      value: "\u0410 \u043F\u0440\u043E\u0445\u043E\u0434 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434
        \u043C\u0435\u043B\u043A\u0438\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432
        \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E
        \u0443\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E \u0432\u0437\u043E\u0440\u0432\u0430\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[27].text
      value: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E \u0432\u0441\u0435 \u044D\u0442\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[28].text
      value: "\u0427\u0435\u0440\u0442 \u0441 \u0438\u0445 \u0432\u0435\u043B\u0438\u043A\u0438\u043C
        \u0421\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u043C, \u044F \u043D\u0435
        \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C\u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
        \u0437\u0434\u0435\u0441\u044C, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0443\u0441\u044C
        \u0432 \u0433\u0440\u0443\u0434\u0443 \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043B\u043E\u043C\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[29].text
      value: "\u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
        \u0434\u043E\u043C\u043E\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 5765317808143057153, guid: fca59698084d2eb42970e00a853df4f9, type: 3}
      propertyPath: dialogs.Array.data[0].dialogObject

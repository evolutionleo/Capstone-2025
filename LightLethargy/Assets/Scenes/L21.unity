  dialogs:
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 684814567}
    additionalStartPause: 0
    text: "\u0411\u0430\u0448\u043D\u044F \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C."
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 684814567}
    additionalStartPause: 0
    text: "\u0414\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B \u043D\u0435
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F. \u0415\u0441\u0442\u044C
      \u043B\u0438 \u0435\u0449\u0435 \u043F\u0443\u0442\u0438?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 684814567}
    additionalStartPause: 0
    text: "\u2026 \u0445\u043C\u2026"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 684814567}
    additionalStartPause: 0
    text: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0435 \u0432\u0441\u0435
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B

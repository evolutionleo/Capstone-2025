    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 684814567}
    additionalStartPause: 0
    text: "\u0427\u0442\u043E \u044D\u0442\u043E \u0432\u0441\u0435 \u0437\u043D\u0430\u0447\u0438\u0442?"
    additionalEndPause: 0
  - Event:
      m_PersistentCalls:
        m_Calls: []
    dialogObject: {fileID: 684814567}
    additionalStartPause: 0
    text: "\u0421\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u2026 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435\u2026
